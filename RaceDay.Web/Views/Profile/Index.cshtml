@model RaceDay.Web.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="login-page">
    <div class="login-card register-card">

        <div class="login-brand">
            <div class="login-logo">R</div>
            <h2>RACEDAY</h2>
            <span>MY PARTICIPANT PROFILE</span>
        </div>

        <div class="login-heading">
            <h3>Manage Your Profile</h3>
            <p>Update your personal information and profile picture.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Profile"
              asp-action="Index"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="text-center mb-4">
                @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                {
                    <img src="@Model.ProfilePicture"
                         alt="Profile picture"
                         class="profile-picture-preview" />
                }
                else
                {
                    <div class="profile-picture-placeholder">
                        <span>R</span>
                    </div>
                }
            </div>

            <div class="mb-3">
                <label asp-for="ProfileImage" class="form-label">
                    Profile Picture
                </label>
                <input asp-for="ProfileImage"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp"
                       class="form-control login-input" />
                <span asp-validation-for="ProfileImage"
                      class="text-danger"></span>
                <small class="text-muted">
                    JPG, JPEG, PNG or WEBP. Maximum size: 5 MB.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">
                    First Name
                </label>
                <input asp-for="FirstName"
                       class="form-control login-input" />
                <span asp-validation-for="FirstName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">
                    Last Name
                </label>
                <input asp-for="LastName"
                       class="form-control login-input" />
                <span asp-validation-for="LastName"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>
                <input asp-for="Email"
                       type="email"
                       class="form-control login-input" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary login-button">
                Save Changes
            </button>

        </form>

        <div class="login-footer">
            <a asp-controller="Participant" asp-action="Index">
                Back to Dashboard
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}