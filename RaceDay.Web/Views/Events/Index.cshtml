@model List<RaceDay.Web.Models.Event>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">
    <h2>Manage Events</h2>

    <a asp-action="Create" class="btn btn-primary mb-3">
        Create New Event
    </a>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Event ID</th>
                <th>Event Name</th>
                <th>Event Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventID</td>
                    <td>@item.EventName</td>
                    <td>@item.EventDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.EventID"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this event?');">

                            <input type="hidden"
                                   name="id"
                                   value="@item.EventID" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
