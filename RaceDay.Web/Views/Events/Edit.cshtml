
@model RaceDay.Web.Models.Event
@using RaceDay.Web.Models

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">
    <h2>Edit Event</h2>

    <form asp-action="Edit" asp-route-id="@Model.EventID" method="post">

        <input type="hidden" asp-for="EventID" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="EventName" class="form-label">Event Name</label>
            <input asp-for="EventName" class="form-control" />
            <span asp-validation-for="EventName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EventDate" class="form-label">Event Date</label>
            <input asp-for="EventDate"
                   type="datetime-local"
                   class="form-control"
                   value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="EventDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryID" class="form-label">Category</label>
            <select asp-for="CategoryID" class="form-select">
                <option value="">Select Category</option>
                @foreach (var category in (ViewBag.Categories as List<Category>) ?? new List<Category>())
                {
                    <option value="@category.CategoryID">
                        @category.CategoryName
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="LocationID" class="form-label">Location</label>
            <select asp-for="LocationID" class="form-select">
                <option value="">Select Location</option>
                @foreach (var location in (ViewBag.Locations as List<Location>) ?? new List<Location>())
                {
                    <option value="@location.LocationID">
                        @location.LocationName
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
