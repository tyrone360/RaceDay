@model List<RaceDay.Web.Models.Enrollment>

@{
    ViewData["Title"] = "Manage Event Enrollments";
}

<div class="container mt-4">
    <h2>Manage Event Enrollments</h2>

    <a asp-action="Create" class="btn btn-primary mb-3">
        Create New Enrollment
    </a>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Enrollment ID</th>
                <th>User ID</th>
                <th>Event ID</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EnrollmentID</td>
                    <td>@item.UserID</td>
                    <td>@item.EventID</td>
                    <td>
                        <form asp-action="Delete" method="post"
                              onsubmit="return confirm('Are you sure you want to delete this enrollment?');">
                            <input type="hidden" name="id" value="@item.EnrollmentID" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
