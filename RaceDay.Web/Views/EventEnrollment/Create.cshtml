@model RaceDay.Web.Models.Enrollment

@{
    ViewData["Title"] = "Create Enrollment";
}

<div class="container mt-4">
    <h2>Create Event Enrollment</h2>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="UserID" class="form-label">User ID</label>
            <input asp-for="UserID" class="form-control" type="number" />
            <span asp-validation-for="UserID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EventID" class="form-label">Event ID</label>
            <input asp-for="EventID" class="form-control" type="number" />
            <span asp-validation-for="EventID" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save Enrollment</button>

        <a asp-action="Index" class="btn btn-secondary">Back to Enrollments</a>

    </form>
</div>
