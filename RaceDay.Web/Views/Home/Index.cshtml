```cshtml
@{
    ViewData["Title"] = "Home";
}

<section class="raceday-hero">
    <div class="hero-content">
        <span class="hero-label">WELCOME TO RACEDAY</span>

        <h1>
            PUSH YOUR LIMITS.<br />
            <span>CHASE GREATNESS.</span>
        </h1>

        <p>
            Discover sporting events, challenge yourself,
            connect with athletes and make every moment count.
        </p>

        <div class="hero-buttons">
            <a asp-controller="Participant"
               asp-action="Events"
               class="btn btn-primary btn-lg">
                Explore Events
            </a>

            <a asp-controller="Home"
               asp-action="Privacy"
               class="btn btn-outline-light btn-lg">
                Learn More
            </a>
        </div>
    </div>

    <div class="hero-decoration">
        <div class="hero-circle"></div>
        <div class="hero-text">RACE<br />DAY</div>
    </div>
</section>

<section class="raceday-features container">
    <div class="text-center mb-5">
        <span class="hero-label">WHY RACEDAY?</span>
        <h2>Everything You Need to Compete</h2>
        <p>One platform. Endless opportunities.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">01</div>
                <h4>Discover Events</h4>
                <p>Explore upcoming sporting events and find your next challenge.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">02</div>
                <h4>Easy Enrolment</h4>
                <p>Register for events and keep track of your enrolments.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">03</div>
                <h4>Track Results</h4>
                <p>Stay updated with your event results and performance.</p>
            </div>
        </div>
    </div>
</section>
```