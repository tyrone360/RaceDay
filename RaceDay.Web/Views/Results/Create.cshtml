@model RaceDay.Web.Models.Result

@{
    ViewData["Title"] = "Add Result";
}

<div class="container mt-4">
    <h2>Add New Result</h2>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="EnrollmentID" class="form-label">
                Enrollment ID
            </label>

            <input asp-for="EnrollmentID"
                   class="form-control"
                   type="number" />

            <span asp-validation-for="EnrollmentID"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label">
                Position
            </label>

            <input asp-for="Position"
                   class="form-control"
                   type="number"
                   min="1" />

            <span asp-validation-for="Position"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Result
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back to Results
        </a>

    </form>
</div>
